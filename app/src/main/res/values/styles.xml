<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="@android:style/Theme.Holo.Light.DarkActionBar">
        <item name="android:itemTextAppearance">@style/AppMenuItemText</item>
        <item name="android:actionMenuTextAppearance">@style/AppMenuItemText</item>
        <item name="android:alertDialogTheme">@style/AppDialogTheme.Light</item>
    </style>
    <style name="AppTheme.Dark" parent="@android:style/Theme.Holo">
        <item name="android:itemTextAppearance">@style/AppMenuItemText</item>
        <item name="android:actionMenuTextAppearance">@style/AppMenuItemText</item>
        <item name="android:alertDialogTheme">@style/AppDialogTheme.Dark</item>
    </style>
    <style name="AppMenuItemText" parent="@android:style/TextAppearance.Medium">
        <item name="android:textSize">32sp</item>
    </style>
    <style name="AppDialogTheme.Light" parent="@android:style/Theme.Holo.Light.Dialog">
        <item name="android:textAppearanceMedium">@style/AppDialogText</item>
        <item name="android:textAppearanceLarge">@style/AppDialogTitleText</item>
        <item name="android:textAppearanceListItem">@style/AppDialogText</item>
        <item name="android:textAppearanceListItemSmall">@style/AppDialogText</item>
    </style>
    <style name="AppDialogTheme.Dark" parent="@android:style/Theme.Holo.Dialog">
        <item name="android:textAppearanceMedium">@style/AppDialogText</item>
        <item name="android:textAppearanceLarge">@style/AppDialogTitleText</item>
        <item name="android:textAppearanceListItem">@style/AppDialogText</item>
        <item name="android:textAppearanceListItemSmall">@style/AppDialogText</item>
    </style>
    <style name="AppDialogText" parent="@android:style/TextAppearance.Medium">
        <item name="android:textSize">32sp</item>
    </style>
    <style name="AppDialogTitleText" parent="@android:style/TextAppearance.Large">
        <item name="android:textSize">32sp</item>
    </style>
</resources>